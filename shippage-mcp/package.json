    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "publish",
    "publish-html",
    "html-hosting",
    "markdown",
    "ai-agent",
    "claude",
    "claude-code",
    "cursor",
    "shippage"
  ],
  "homepage": "https://shippage.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jieshu666/ShipPage-Skill.git",
    "directory": "shippage-mcp"
  },
  "bugs": {
    "url": "https://github.com/jieshu666/ShipPage-Skill/issues"
  },
  "author": "ShipPage (https://shippage.ai)",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "marked": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3"
  }
}
